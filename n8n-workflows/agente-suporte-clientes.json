{
  "name": "CoyDash · Agente de Atendimento e Suporte a Clientes Ativos",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-suporte-clientes",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "node-webhook-clientes",
      "name": "1. Webhook Z-API (Ao receber)"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fld-telefone",
              "name": "telefone",
              "value": "={{ $json.body?.phone || $json.body?.senderPhone || $json.body?.from || '' }}",
              "type": "string"
            },
            {
              "id": "fld-nome",
              "name": "nome",
              "value": "={{ $json.body?.senderName || $json.body?.contact?.name || 'Cliente' }}",
              "type": "string"
            },
            {
              "id": "fld-mensagem",
              "name": "mensagem",
              "value": "={{ $json.body?.text?.message || $json.body?.message?.conversation || $json.body?.caption || '' }}",
              "type": "string"
            },
            {
              "id": "fld-isGroup",
              "name": "isGroup",
              "value": "={{ $json.body?.isGroup || false }}",
              "type": "boolean"
            },
            {
              "id": "fld-datahora",
              "name": "hora_data_mensagem",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "id": "node-edit-fields-clientes",
      "name": "2. Extrair Dados da Mensagem"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-not-group",
              "leftValue": "={{ $json.isGroup }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "cond-has-msg",
              "leftValue": "={{ $json.mensagem.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0],
      "id": "node-if-valido-clientes",
      "name": "3. Mensagem Válida?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, team_squad, status, ad_spend, ad_results, ad_cpr, ad_balance, traffic_manager_name, cs_manager_name FROM public.clients WHERE replace(replace(replace(replace(contact_phone, ' ', ''), '-', ''), '(', ''), ')', '') LIKE '%' || substring($1 from 5) LIMIT 1;",
        "options": {
          "queryParams": "={{ [$('2. Extrair Dados da Mensagem').item.json.telefone] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [680, 0],
      "id": "node-buscar-cliente-carteira",
      "name": "4. Buscar na Carteira (public.clients)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.leads (lead_id, lead_nome, inbox_type, client_id, crm_stage, human_takeover, created_at) VALUES ($1, $2, 'CLIENT', $3, 'ACTIVE', false, now()) ON CONFLICT (lead_id) DO UPDATE SET lead_nome = EXCLUDED.lead_nome, client_id = COALESCE(leads.client_id, EXCLUDED.client_id) RETURNING id, human_takeover;",
        "options": {
          "queryParams": "={{ [$('2. Extrair Dados da Mensagem').item.json.telefone, $json?.name || $('2. Extrair Dados da Mensagem').item.json.nome, $json?.id || null] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [920, 0],
      "id": "node-upsert-lead-cliente",
      "name": "5. Atualizar Lead no Atendimento"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-not-takeover",
              "leftValue": "={{ $json?.human_takeover || false }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1140, 0],
      "id": "node-if-ia-ativa-clientes",
      "name": "6. IA Pode Responder? (Takeover = False)"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('2. Extrair Dados da Mensagem').item.json.mensagem }}",
        "options": {
          "systemMessage": "Você é o assistente virtual de atendimento operacional aos clientes ativos da Coytech no WhatsApp.\n\nCONTEXTO DO CLIENTE:\nNome do Cliente: {{ $('4. Buscar na Carteira (public.clients)').item.json?.name || 'Cliente Parceiro' }}\nSquad: {{ $('4. Buscar na Carteira (public.clients)').item.json?.team_squad || 'Operacional' }}\nGestor de Tráfego: {{ $('4. Buscar na Carteira (public.clients)').item.json?.traffic_manager_name || 'Equipe de Performance' }}\nCustomer Success: {{ $('4. Buscar na Carteira (public.clients)').item.json?.cs_manager_name || 'Atendimento' }}\n\nDIRETRIZES DE ATENDIMENTO:\n1. Escreva em parágrafos curtos e amigáveis, separados por linha em branco (\\n\\n) para simular digitação natural.\n2. Responda dúvidas sobre andamento de campanhas, prazos de criativos e suporte operacional.\n3. Caso o cliente peça relatório complexo, ajuste de criativo urgente ou queira falar com o gestor/humano, acolha a solicitação e informe que o gestor de tráfego já recebeu o alerta na ficha do cliente no painel.\n4. Nunca prometa resultados inatingíveis e mantenha a discrição sobre informações confidenciais."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1380, -100],
      "id": "node-ai-agent-clientes",
      "name": "7. Agente IA Suporte Clientes"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.3
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1380, 100],
      "id": "node-model-openai-clientes",
      "name": "OpenAI Chat Model (gpt-4o-mini)"
    },
    {
      "parameters": {
        "tableName": "n8n_chat_histories",
        "sessionKey": "={{ $('2. Extrair Dados da Mensagem').item.json.telefone }}"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [1500, 100],
      "id": "node-memory-postgres-clientes",
      "name": "Postgres Chat Memory (Supabase Pooler 6543)"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.output || '';\nconst parts = text.split(/\\n\\n+/).map(p => p.trim()).filter(Boolean);\nreturn parts.map(part => ({ json: { textPart: part } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, -100],
      "id": "node-split-text-clientes",
      "name": "8. Quebrar em Balões Curtos"
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1920, -100],
      "id": "node-wait-clientes",
      "name": "9. Esperar 3 Segundos"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.z-api.io/instances/SUA_INSTANCIA_AQUI/token/SEU_TOKEN_AQUI/send-text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Client-Token",
              "value": "SEU_CLIENT_TOKEN_ZAPI_AQUI"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $('2. Extrair Dados da Mensagem').item.json.telefone }}"
            },
            {
              "name": "message",
              "value": "={{ $json.textPart }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2140, -100],
      "id": "node-send-zapi-clientes",
      "name": "10. Enviar WhatsApp (Z-API)"
    }
  ],
